    {
      "name": "👥 Users Management (Admin Only)",
      "item": [
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/users",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Admin ONLY. Returns list of all users and total count."
          }
        },
        {
          "name": "Get Single User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/users/{{userId}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "users",
                "{{userId}}"
              ]
            },
            "description": "Admin ONLY. Returns single user details."
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ACCESS_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Doctor\",\n  \"email\": \"newdoc@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"doctor\",\n  \"phone\": \"01700112233\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/users",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "Update User",
