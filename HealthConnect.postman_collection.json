{
  "info": {
    "_postman_id": "healthconnect-patient-registration",
    "name": "HealthConnect API",
    "description": "HealthConnect Backend API - Patient & Doctor Multi-Step Registration & Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "TEMP_TOKEN",
      "value": "",
      "type": "string"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🏥 Health Check",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/health",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "👤 Patient Registration (Multi-Step)",
      "item": [
        {
          "name": "Step 1 - Initiate Registration (Send OTP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    console.log('✅ OTP sent! Check your email:', res.data.email);",
                  "    pm.test('OTP sent successfully', () => {",
                  "        pm.expect(res.success).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Topan Roy\",\n  \"email\": \"roytopan734@gmail.com\",\n  \"password\": \"Test@1234\",\n  \"phone\": \"01700000000\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/patient/initiate",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "patient",
                "initiate"
              ]
            }
          }
        },
        {
          "name": "Step 2 - Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const res = pm.response.json();",
                  "    if (res.data && res.data.tempToken) {",
                  "        pm.collectionVariables.set('TEMP_TOKEN', res.data.tempToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"roytopan734@gmail.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/patient/verify-otp",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "patient",
                "verify-otp"
              ]
            }
          }
        },
        {
          "name": "Step 3 - Complete Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const res = pm.response.json();",
                  "    if (res.data && res.data.accessToken) {",
                  "        pm.collectionVariables.set('ACCESS_TOKEN', res.data.accessToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TEMP_TOKEN}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateOfBirth\": \"1995-06-15\",\n  \"gender\": \"male\",\n  \"bloodGroup\": \"B+\",\n  \"height\": 175,\n  \"weight\": 68,\n  \"allergies\": \"Dust, Pollen\",\n  \"existingConditions\": \"None\",\n  \"emergencyContactName\": \"Rahim Roy\",\n  \"emergencyContactRelationship\": \"Father\",\n  \"emergencyContactPhone\": \"01811111111\",\n  \"division\": \"Dhaka\",\n  \"district\": \"Dhaka\",\n  \"area\": \"Mirpur\",\n  \"fullAddress\": \"House 12, Road 5, Mirpur-10, Dhaka-1216\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/auth/patient/complete-profile",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "patient",
                "complete-profile"
              ]
            }
          }
        }
      ]
    },
